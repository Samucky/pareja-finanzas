# === Desarrollo local (opcional: Atlas o Mongo local) ===
PORT=4000

# MongoDB Atlas (añade /pareja_finanzas antes de ?):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/pareja_finanzas?retryWrites=true&w=majority&appName=Cluster0

# MongoDB local (solo si usas Docker/local):
MONGODB_URI=mongodb://127.0.0.1:27017/pareja_finanzas

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CORS_ORIGIN=*

# En Render: NO definas PORT (lo asigna Render). Solo las variables de arriba excepto PORT.
